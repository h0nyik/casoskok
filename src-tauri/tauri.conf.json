{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hodinový skokan",
  "version": "0.2.3",
  "identifier": "cz.roztisk.hodinovy-skokan",
  "build": {
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hodinový skokan",
        "width": 400,
        "height": 680,
        "minWidth": 400,
        "minHeight": 680,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "center": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Tray utilita: kolik bude hodin za X hodin.",
    "longDescription": "Hodinový skokan je minimalistická tray utilita s dark mode, oknem bez lišty, always-on-top popoverem a automatickými aktualizacemi.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzOTBGQzY4RkIwRTNFNzQKUldSMFBnNzdhUHlRdzk4L2VFY3VHaHZaT2FLN1hDZ2cvUUxMQW94RUlIeUVES2Nra0hyKzErWVcK",
      "endpoints": [
        "https://github.com/h0nyik/casoskok/releases/latest/download/latest.json"
      ]
    }
  }
}
