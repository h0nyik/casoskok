{
  "name": "hodinovy-skokan",
  "version": "0.2.0",
  "private": true,
  "description": "Minimalistická tray utilita: kolik bude hodin za X hodin. Time Hopper desktop app with dark mode and auto-update.",
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "desktop:build": "tauri build",
    "desktop:build:mac": "tauri build --bundles app,dmg --target universal-apple-darwin",
    "desktop:build:windows": "tauri build --bundles msi,nsis",
    "desktop:dev": "tauri dev",
    "start": "python3 -m http.server 4173",
    "serve": "python3 -m http.server 4173",
    "tauri": "tauri"
  },
  "keywords": [
    "pwa",
    "tray",
    "menubar",
    "cas",
    "hodiny",
    "time-hopper",
    "widget"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1"
  }
}
